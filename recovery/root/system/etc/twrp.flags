# TWRP v1-format flags for degas (Xiaomi 14T).
# Active-slot symlinks (/dev/block/by-name/{boot,init_boot,vendor_boot,dtbo,
# vbmeta,vbmeta_system,vbmeta_vendor}) are populated dynamically on fs by
# /system/bin/degas_slot_symlinks.sh so both Slot A and Slot B work identically.
#<mnt_point>              <type>  <device>                            <flags>
/cache                    ext4    /dev/block/by-name/rescue           flags=display="Cache";wipeingui;wipeduringfactoryreset
/metadata                 f2fs    /dev/block/by-name/metadata         flags=display="Metadata";backup=1;wipeingui

# Persist raw image backup/restore (avoids double-mounting /mnt/vendor/persist used rw by MiTEE)
/persist_image            emmc    /dev/block/by-name/persist          flags=display="Persist (Image)";backup=1;flashimg=1

# Physical partitions — active slot aware, backup & image flash enabled
/boot                     emmc    /dev/block/by-name/boot             flags=display="Boot";backup=1;flashimg=1
/init_boot                emmc    /dev/block/by-name/init_boot        flags=display="Init Boot";backup=1;flashimg=1
/vendor_boot              emmc    /dev/block/by-name/vendor_boot      flags=display="Vendor Boot";backup=1;flashimg=1
/dtbo                     emmc    /dev/block/by-name/dtbo             flags=display="DTBO";backup=1;flashimg=1
/super                    emmc    /dev/block/by-name/super            flags=display="Super";backup=1;flashimg=1
/vbmeta                   emmc    /dev/block/by-name/vbmeta           flags=display="Vbmeta";backup=1;flashimg=1
/vbmeta_system            emmc    /dev/block/by-name/vbmeta_system    flags=display="Vbmeta System";backup=1;flashimg=1
/vbmeta_vendor            emmc    /dev/block/by-name/vbmeta_vendor    flags=display="Vbmeta Vendor";backup=1;flashimg=1

# IMEI & calibration partitions — backup-only (no wipeingui for safety)
/nvram                    emmc    /dev/block/by-name/nvram            flags=display="NVRAM (IMEI)";backup=1
/nvdata                   ext4    /dev/block/by-name/nvdata           flags=display="NVDATA";backup=1
/nvcfg                    ext4    /dev/block/by-name/nvcfg            flags=display="NVCFG";backup=1
/protect_f                ext4    /dev/block/by-name/protect1         flags=display="Protect_F";backup=1
/protect_s                ext4    /dev/block/by-name/protect2         flags=display="Protect_S";backup=1
